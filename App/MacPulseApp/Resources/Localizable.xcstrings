            "value" : "MacPulse نفسه"
          }
        }
      }
    },
    "MacPulse keeps %lld days of hourly CPU and energy use per app, to show trends. It stores app names and locations only — never documents, window titles or what you do in an app." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "يحتفظ MacPulse بـ %lld أيام من استخدام المعالج والطاقة لكل تطبيق كل ساعة لعرض الاتجاهات. يخزن أسماء التطبيقات ومواقعها فقط — ولا يخزن أبدًا المستندات أو عناوين النوافذ أو ما تفعله داخل التطبيق."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "يحتفظ MacPulse بـ %lld يومًا من استخدام المعالج والطاقة لكل تطبيق كل ساعة لعرض الاتجاهات. يخزن أسماء التطبيقات ومواقعها فقط — ولا يخزن أبدًا المستندات أو عناوين النوافذ أو ما تفعله داخل التطبيق."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "يحتفظ MacPulse بـ يوم واحد من استخدام المعالج والطاقة لكل تطبيق كل ساعة لعرض الاتجاهات. يخزن أسماء التطبيقات ومواقعها فقط — ولا يخزن أبدًا المستندات أو عناوين النوافذ أو ما تفعله داخل التطبيق."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "يحتفظ MacPulse بـ %lld يوم من استخدام المعالج والطاقة لكل تطبيق كل ساعة لعرض الاتجاهات. يخزن أسماء التطبيقات ومواقعها فقط — ولا يخزن أبدًا المستندات أو عناوين النوافذ أو ما تفعله داخل التطبيق."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "يحتفظ MacPulse بـ يومين من استخدام المعالج والطاقة لكل تطبيق كل ساعة لعرض الاتجاهات. يخزن أسماء التطبيقات ومواقعها فقط — ولا يخزن أبدًا المستندات أو عناوين النوافذ أو ما تفعله داخل التطبيق."
                }
