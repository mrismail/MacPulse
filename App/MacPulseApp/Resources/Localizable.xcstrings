    "Voltage" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الجهد"
          }
        }
      }
    },
    "Volume" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "وحدة التخزين"
          }
        }
      }
    },
    "While MacPulse is in the menu bar, closing its window keeps it running so battery and app activity are still recorded. Opening at login is off unless you turn it on; you can also change it in System Settings > General > Login Items." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عندما يكون MacPulse في شريط القوائم، يبقى قيد التشغيل بعد إغلاق نافذته حتى يستمر تسجيل البطارية ونشاط التطبيقات. الفتح عند تسجيل الدخول متوقف ما لم تفعّله؛ ويمكنك أيضًا تغييره في إعدادات النظام > عام > عناصر تسجيل الدخول."
          }
        }
      }
    },
    "While the Energy screen is open, app activity is measured every 10 seconds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أثناء فتح شاشة الطاقة، يُقاس نشاط التطبيقات كل 10 ثوانٍ."
          }
        }
      }
    },
    "Your battery may need service" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قد تحتاج البطارية إلى صيانة"
          }
        }
      }
    },
    "cleanable" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قابل للتنظيف"
          }
        }
      }
    },
    "every 30 seconds" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "كل 30 ثانية"
          }
        }
      }
    },
    "every 5 minutes" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "كل 5 دقائق"
          }
        }
      }
    },
    "every minute" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "كل دقيقة"
          }
        }
      }
    },
    "macOS" : {
      "shouldTranslate" : false
    },
    "macOS & background" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "macOS والخلفية"
          }
        }
      }
    },
    "macOS didn't move it back: %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم يُعِده macOS: %@"
          }
        }
      }
    },
    "macOS didn't move it: %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم ينقله macOS: %@"
          }
        }
      }
    },
    "macOS doesn't let MacPulse look inside the Trash. Use Put Back in the Trash in Finder, or allow Full Disk Access in System Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يسمح macOS لـ MacPulse برؤية محتويات سلة المهملات. استخدم أمر الإعادة في سلة المهملات في Finder، أو امنح الوصول الكامل إلى القرص في إعدادات النظام."
          }
        }
      }
    },
    "macOS estimate" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تقدير macOS"
          }
        }
      }
    },
    "macOS lets only apps with Full Disk Access look inside the Trash. Open it in Finder to see and empty it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يسمح macOS برؤية محتويات سلة المهملات إلا للتطبيقات التي لديها وصول كامل إلى القرص. افتحها في Finder لعرضها وإفراغها."
          }
        }
      }
    },
    "macOS moved the item but didn't say where; look for it in the Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نقل macOS العنصر لكنه لم يحدد مكانه؛ ابحث عنه في سلة المهملات."
          }
        }
      }
    },
    "macOS needs your approval: turn MacPulse on in System Settings > General > Login Items." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحتاج macOS إلى موافقتك: فعّل MacPulse في إعدادات النظام > عام > عناصر تسجيل الدخول."
          }
        }
      }
    },
    "macOS reports the battery condition as “%@”. Consider checking it with Apple Support." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يبلغ macOS عن حالة البطارية بأنها «⁨%@⁩». يُستحسن فحصها مع دعم Apple."
          }
        }
      }
    },
    "macOS returned an unexpected value (%@)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "أعاد macOS قيمة غير متوقعة (%@)."
          }
        }
      }
    },
    "—" : {
      "shouldTranslate" : false
    },
    "“%@” is a standard folder of your account. Choose a folder inside it instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«⁨%@⁩» مجلد قياسي في حسابك. اختر مجلدًا بداخله بدلًا من ذلك."
          }
        }
      }
    },
    "−%@ since last scan" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "−%@ منذ آخر فحص"
          }
