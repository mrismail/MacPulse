    },
    "Scans and cleanup" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الفحص والتنظيف"
          }
        }
      }
    },
    "Scans only read file sizes; nothing is changed. Desktop, Documents, Downloads and other apps' data are skipped unless you choose them, so macOS doesn't ask for permission unexpectedly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يقرأ الفحص أحجام الملفات فقط؛ ولا يتغير أي شيء. يتم تخطي سطح المكتب والمستندات والتنزيلات وبيانات التطبيقات الأخرى ما لم تخترها، حتى لا يطلب macOS الإذن بشكل غير متوقع."
          }
