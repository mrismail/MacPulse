    "%@ has averaged %@ CPU for the last %lld minutes. Sustained CPU use is a common cause of faster battery drain." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استخدم ⁨%1$@⁩ في المتوسط %2$@ من المعالج خلال آخر %3$lld دقيقة. الاستخدام المستمر للمعالج سبب شائع لنفاد البطارية بسرعة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
